# Example environment for generated stacks.
# Copy to .env and adjust as needed. Never commit real secrets.

# Default project name used by the scaffolder.
DCT_PROJECT_NAME=myapp

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MongoDB
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=root
MONGO_PORT=27017

# Elasticsearch
ELASTIC_PORT=9200
